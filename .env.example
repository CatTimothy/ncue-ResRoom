# 必填
DATABASE_URL=postgres://帳號:密碼@localhost:5432/ncue_resroom
# 執行 npm test 時才需要，帳號要有建立資料庫的權限
TEST_DATABASE_URL=
PORT=4000
# 上傳檔案的位置
DATA_DIR=./data
# 前端與 API 不同網址時才需要，以逗號分隔，例如 http://localhost:5173,https://resroom.example.edu.tw
CORS_ORIGINS=
# 設為 production 時：關閉 GraphiQL，登入 cookie 僅限 HTTPS
NODE_ENV=development
