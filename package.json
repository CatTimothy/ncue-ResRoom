    "create-user": "node --env-file-if-exists=.env src/scripts/create-user.js",
    "seed-content": "node --env-file-if-exists=.env src/scripts/seed-content.js"
  },
  "dependencies": {
    "graphql": "^17.0.2",
    "graphql-yoga": "^6.0.1",
    "marked": "^18.1.3",
