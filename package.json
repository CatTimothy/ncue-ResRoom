{
  "name": "simple-site-cms-api",
  "version": "0.1.0",
  "description": "開源簡易官網管理系統",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
